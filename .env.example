# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and must NEVER be committed to version control.

# Groq API key used for server-side AI content moderation.
GROQ_API_KEY=

# TiDB Cloud Serverless connection settings.
TIDB_HOST=
TIDB_USER=
TIDB_PASSWORD=
# Note: the default TiDB Cloud user is denied CREATE on the `sys` schema
# (Error 1142), so the writable `test` schema is used unless a dedicated
# database is provisioned for this app.
TIDB_DATABASE=test

# Optional: override the Groq moderation model (default: openai/gpt-oss-20b).
# GROQ_MODEL=openai/gpt-oss-20b